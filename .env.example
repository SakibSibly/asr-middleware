# ASR Middleware Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=False
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
API_KEY=your-secret-api-key-change-this

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/asr_middleware

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage (Choose one: Local or S3)
USE_S3=False
LOCAL_STORAGE_PATH=./media

# AWS S3 (if USE_S3=True)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=asr-middleware
AWS_S3_REGION_NAME=us-east-1

# Fireflies.ai Integration
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# OpenAI (for Whisper API & GPT translation)
OPENAI_API_KEY=
WHISPER_MODEL=large-v3

# Google Cloud (for Speech-to-Text & Translation)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# AssemblyAI (alternative ASR with diarization)
ASSEMBLYAI_API_KEY=

# Translation Services
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# Monitoring & Logging
SENTRY_DSN=
